# O usuário informa a distância, e o programa decide o que fazer
distancia = float(input("Digite a distância em metros: "))

if distancia > 10:
    print("Distância longa! Diminua a velocidade.")
elif distancia >= 5:
    print("Distância média, mantenha o ritmo.")
else:
    print("Distância curta, prepare-se para parar.")


# O usuário informa a direção e a distância
direcao = input("Digite a direção (direita ou esquerda): ").lower()
distancia = float(input("Digite a distância em metros: "))

if direcao == "direita":
    print(f"Você andou {distancia} metros para a direita.")
elif direcao == "esquerda":
    print(f"Você andou {distancia} metros para a esquerda.")
else:
    print("Direção inválida.")

